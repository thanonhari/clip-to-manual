{
  "name": "clip-to-manual",
  "version": "1.0.0",
  "description": "Transform YouTube tutorials and playlists into structured, step-by-step software user manuals.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "check": "oxlint src/ && tsc --noEmit",
    "test": "tsx src/test-runner.ts"
  },
  "keywords": [
    "youtube",
    "manual-generator",
    "documentation",
    "transcript",
    "gemini",
    "typescript",
    "anti-slop"
  ],
  "author": "Antigravity Pair Programmer",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "oxlint": "^0.15.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
